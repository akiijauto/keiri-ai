# /etc/systemd/system/keiri-ai-api.service
[Unit]
Description=Keiri AI - FastAPI backend
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/opt/keiri-ai/api
EnvironmentFile=/opt/keiri-ai/.env
ExecStart=/opt/keiri-ai/api/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8101
Restart=on-failure
RestartSec=5
# メモリ上限（既存24サービスと同居のため）
MemoryMax=1G

[Install]
WantedBy=multi-user.target
