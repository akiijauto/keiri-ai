{
  "comment": "OCR行テキストから業務項目を抽出する共通テストベクタ。すべて架空データ。confidence は base(same_line=0.9 / next_line=0.75 / pattern=0.6) x 行信頼度 を小数第2位で四捨五入した値。",
  "profile": "jp.personal.basic/1",
  "cases": [
    {
      "id": "extract-01-residency",
      "document_type": "residency_application",
      "lines": [
        "入居申込書",
        "氏名: 山田　太郎",
        "フリガナ: ヤマダ　タロウ",
        "生年月日: 昭和55年1月1日",
        "〒150-0001",
        "住所: 東京都渋谷区神宮前１－２－３",
        "　　　グランドメゾン渋谷 401",
        "電話番号: 090-1234-5678",
        "メールアドレス: taro.yamada@example.co.jp",
        "入居予定日: 令和8年4月1日"
      ],
      "expected": {
        "name":         { "value": "山田　太郎", "confidence": 0.9, "valid": true },
        "name_kana":    { "value": "ヤマダ　タロウ", "confidence": 0.9, "valid": true },
        "birthday":     { "value": "1980-01-01", "confidence": 0.9, "valid": true },
        "postal_code":  { "value": "150-0001", "confidence": 0.9, "valid": true },
        "address":      { "value": "東京都渋谷区神宮前1-2-3　グランドメゾン渋谷　401", "confidence": 0.9, "valid": true },
        "phone":        { "value": "09012345678", "confidence": 0.9, "valid": true },
        "email":        { "value": "taro.yamada@example.co.jp", "confidence": 0.9, "valid": true },
        "move_in_date": { "value": "2026-04-01", "confidence": 0.9, "valid": true }
      }
    },
    {
      "id": "extract-02-label-on-own-line",
      "document_type": "contact_registration",
      "lines": [
        "お客様番号　CUS-1024",
        "お名前",
        "山田　花子",
        "カナ",
        "ﾔﾏﾀﾞ ﾊﾅｺ",
        "TEL 03-1234-5678",
        "E-mail  hanako@example.com"
      ],
      "expected": {
        "customer_no": { "value": "CUS-1024", "confidence": 0.9, "valid": true },
        "name":        { "value": "山田　花子", "confidence": 0.75, "valid": true },
        "name_kana":   { "value": "ヤマダ　ハナコ", "confidence": 0.75, "valid": true },
        "phone":       { "value": "0312345678", "confidence": 0.9, "valid": true },
        "email":       { "value": "hanako@example.com", "confidence": 0.9, "valid": true }
      }
    },
    {
      "id": "extract-03-pattern-only",
      "document_type": "generic",
      "lines": [
        "連絡票",
        "090-9876-5432",
        "150-0001",
        "info@example.jp"
      ],
      "expected": {
        "phone":       { "value": "09098765432", "confidence": 0.6, "valid": true },
        "postal_code": { "value": "150-0001", "confidence": 0.6, "valid": true },
        "email":       { "value": "info@example.jp", "confidence": 0.6, "valid": true }
      }
    },
    {
      "id": "extract-04-invalid-value-is-flagged",
      "document_type": "generic",
      "lines": [
        "氏名: 山田　次郎",
        "生年月日: 1980-02-30"
      ],
      "expected": {
        "name":     { "value": "山田　次郎", "confidence": 0.9, "valid": true },
        "birthday": { "value": "", "raw": "1980-02-30", "confidence": 0.0, "valid": false, "error": "E_VALIDATION" }
      }
    },
    {
      "id": "extract-05-low-line-confidence",
      "document_type": "generic",
      "line_confidence": 0.8,
      "lines": [
        "氏名: 山田　三郎",
        "電話: 090-0000-0001"
      ],
      "expected": {
        "name":  { "value": "山田　三郎", "confidence": 0.72, "valid": true },
        "phone": { "value": "09000000001", "confidence": 0.72, "valid": true }
      }
    },
    {
      "id": "extract-06-noise-lines-ignored",
      "document_type": "generic",
      "lines": [
        "※この欄は記入しないでください",
        "受付番号 -----",
        "氏名: 山田　四郎",
        "",
        "備考: 特になし"
      ],
      "expected": {
        "name": { "value": "山田　四郎", "confidence": 0.9, "valid": true }
      }
    }
  ]
}
