<?xml version="1.0" encoding="utf-8"?>
<!--
  クラウドバックアップ・端末間転送を全面的に禁止する（企画書 15）。
  個人情報が端末外へ複製される経路をひとつ減らす。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
