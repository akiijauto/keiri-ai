<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Secure Local OCR</string>
    <key>NSCameraUsageDescription</key>
    <string>紙の書類を読み取るためにカメラを使用します。撮影した画像は端末外へ送信せず、読み取り後に破棄します。</string>
    <key>NSFaceIDUsageDescription</key>
    <string>業務データを保護するため、アプリの起動時に認証します。</string>

    <!--
      写真ライブラリは使わない（VisionKitの書類スキャナのみ）。
      権限説明を持たないことで、実装が写真へ触れないことを構成上も明示する。
    -->

    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- 平文通信は全面禁止。通信先は WebHandoffBridge のオリジン許可リストでさらに限定する。 -->
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>

    <key>UIFileSharingEnabled</key>
    <false/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <false/>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
